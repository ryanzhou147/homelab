# One entrance on the PC's Tailscale address. Certificates come from the local tailscaled
# (enable HTTPS Certificates in the Tailscale admin).
{
	admin off
	auto_https disable_redirects
}

(login) {
	forward_auth 127.0.0.1:9091 {
		uri /auth/api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

{$HOST}:443 {
	bind {$TS_IP}
	tls {
		get_certificate tailscale
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Identity headers come only from Authelia (forward_auth below), never from the visitor.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Name
	request_header -Remote-Email

	handle /auth* {
		reverse_proxy 127.0.0.1:9091
	}
	# Subsonic API used by music apps: they sign in with Navidrome's own app password.
	handle /music/rest/* {
		reverse_proxy unix//sockets/navidrome.sock
	}
	handle /music* {
		import login
		reverse_proxy unix//sockets/navidrome.sock
	}
	# Jellyfin keeps its own accounts (phone and TV apps need them); browsers sign in through
	# Authelia with its SSO plugin.
	handle /video* {
		reverse_proxy 127.0.0.1:8096
	}
	handle /storage* {
		# Second check after Caddy's own routing, so the admin rule cannot be dodged by an
		# address Authelia and Caddy read differently. Remote-Groups comes only from Authelia.
		route {
			import login
			@notadmin not header_regexp Remote-Groups (^|,)\s*admins\s*(,|$)
			respond @notadmin "Forbidden" 403
			reverse_proxy 127.0.0.1:3909
		}
	}
	handle {
		import login
		root * /srv/hub
		file_server
	}
}

# S3 API for code and backup tools: authenticated by S3 access keys, not the login page.
{$HOST}:8443 {
	bind {$TS_IP}
	tls {
		get_certificate tailscale
	}
	reverse_proxy 127.0.0.1:3900
}
