# The only way in to Lidarr, slskd, Sonarr, Radarr, Prowlarr, qBittorrent, Bazarr and Seerr, which have no login of their own and listen on 127.0.0.1
# inside this container's network. Any web page open on this PC can make the browser call these
# ports, either at 127.0.0.1 or through its own domain pointed at 127.0.0.1 (DNS rebinding), and
# slskd's CORS headers would let it read the replies. So the gate refuses:
#   - a client other than Docker's port proxy, such as Jellyfin on the fetch network;
#   - a Host other than the lab's name or localhost (DNS rebinding);
#   - an Origin other than the lab, or a Sec-Fetch-Site that says another site sent it.
# Scripts and curl send neither header and get through on localhost.
{
	admin off
	auto_https off
}

(gate) {
	# Only Docker's port proxy (the PC's 127.0.0.1 ports) may come in, not other containers on
	# the fetch network such as Jellyfin.
	@not_from_pc not remote_ip 172.30.78.1
	respond @not_from_pc "Forbidden" 403
	@foreign_host not host {$HOST} {$OLD_HOST} {$REQUESTS_HOST} 127.0.0.1 localhost
	respond @foreign_host "Forbidden" 403
	@foreign_origin {
		header Origin *
		not {
			header Origin https://{$HOST}
			header Origin https://{$OLD_HOST}
		}
	}
	respond @foreign_origin "Forbidden" 403
	# A plain page load in a tab (a link click) may come from any site: the other site cannot read the
	# reply, and a page load changes nothing in these apps. Not in a frame: that would let another
	# site lay its page over the apps' buttons. No query string either, which GET actions would need.
	@other_site {
		header_regexp Sec-Fetch-Site ^(cross|same)-site$
		not {
			method GET HEAD
			header Sec-Fetch-Mode navigate
			header Sec-Fetch-Dest document
			expression {http.request.uri.query} == ""
		}
	}
	respond @other_site "Forbidden" 403
}

http://:18686 {
	import gate
	reverse_proxy 127.0.0.1:8686
}

http://:15030 {
	import gate
	reverse_proxy 127.0.0.1:5030
}

http://:18989 {
	import gate
	reverse_proxy 127.0.0.1:8989
}

http://:19696 {
	import gate
	reverse_proxy 127.0.0.1:9696
}

http://:17878 {
	import gate
	reverse_proxy 127.0.0.1:7878
}

http://:16767 {
	import gate
	reverse_proxy 127.0.0.1:6767
}

# Seerr's pages come from the lab on port 5055 or REQUESTS_HOST, so those are its allowed Origins.
http://:15055 {
	# Only Docker's port proxy (the PC's 127.0.0.1 ports) may come in, not other containers on
	# the fetch network such as Jellyfin.
	@not_from_pc not remote_ip 172.30.78.1
	respond @not_from_pc "Forbidden" 403
	@foreign_host not host {$HOST} {$OLD_HOST} {$REQUESTS_HOST} 127.0.0.1 localhost
	respond @foreign_host "Forbidden" 403
	@foreign_origin {
		header Origin *
		not {
			header Origin https://{$HOST}:5055
			header Origin https://{$OLD_HOST}:5055
			header Origin https://{$REQUESTS_HOST}
		}
	}
	respond @foreign_origin "Forbidden" 403
	@other_site {
		header_regexp Sec-Fetch-Site ^(cross|same)-site$
		not {
			method GET HEAD
			header Sec-Fetch-Mode navigate
			header Sec-Fetch-Dest document
			expression {http.request.uri.query} == ""
		}
	}
	respond @other_site "Forbidden" 403
	reverse_proxy 127.0.0.1:5055
}

http://:18080 {
	import gate
	reverse_proxy 127.0.0.1:8080
}
