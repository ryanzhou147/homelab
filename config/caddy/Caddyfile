# One entrance on the PC's Tailscale address. HOST gets its certificate from the local tailscaled
# (HOST_TLS=tailscale; enable HTTPS Certificates in the Tailscale admin) or from Let's Encrypt
# through deSEC DNS (HOST_TLS=desec). OLD_HOST and REQUESTS_HOST are optional extra names.
{
	admin off
	auto_https disable_redirects
	# The cross-site checks in site_headers must run before any route sends a request on.
	order respond before handle
}

(login) {
	forward_auth 127.0.0.1:9091 {
		uri /auth/api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

# Login, then a second admins check after Caddy's own routing, so the admin rule cannot be dodged
# by an address Authelia and Caddy read differently. Remote-Groups comes only from Authelia.
(admin) {
	route {
		import login
		@notadmin not header_regexp Remote-Groups (^|,)\s*admins\s*(,|$)
		respond @notadmin "Forbidden" 403
		reverse_proxy {args[0]}
	}
}

(site_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# A name like lab.example.com shares a site with the public website on example.com, so the
	# browser sends the login cookie with requests from its pages. Only the lab's own pages and plain
	# link clicks may come in. Jellyfin and the Subsonic API are left out: they log in with their own
	# tokens, not the cookie, and TV, Cast and desktop players call them from other sites.
	@foreign_page {
		not path /video* /music/rest/*
		header_regexp Sec-Fetch-Site ^(cross|same)-site$
		not {
			method GET HEAD
			header Sec-Fetch-Mode navigate
		}
	}
	respond @foreign_page "Forbidden" 403
	@foreign_origin {
		not path /video* /music/rest/*
		header Origin *
		not {
			header Origin https://{$HOST}
			header Origin https://{$HOST}:5055
			header Origin https://{$OLD_HOST:old.invalid}
			header Origin https://{$OLD_HOST:old.invalid}:5055
			header Origin https://{$REQUESTS_HOST:requests.invalid}
		}
	}
	respond @foreign_origin "Forbidden" 403
	# Identity headers come only from Authelia (the login snippet), never from the visitor.
	request_header -Remote-User
	request_header -Remote-Groups
	request_header -Remote-Name
	request_header -Remote-Email
}

(tls_tailscale) {
	tls {
		get_certificate tailscale
	}
}

(tls_desec) {
	tls {
		dns desec {
			token {env.DESEC_TOKEN}
		}
		# deSEC needs about a minute to publish a record on all its servers; Let's Encrypt
		# looked too early and got NXDOMAIN.
		propagation_delay 2m
		propagation_timeout -1
	}
}

(lab) {
	encode zstd gzip
	import site_headers

	handle /auth* {
		reverse_proxy 127.0.0.1:9091
	}
	# Subsonic API used by music apps: they sign in with Navidrome's own app password.
	handle /music/rest/* {
		reverse_proxy unix//sockets/navidrome.sock
	}
	handle /music* {
		import login
		reverse_proxy unix//sockets/navidrome.sock
	}
	# Jellyfin keeps its own accounts (phone and TV apps need them); browsers sign in through
	# Authelia with its SSO plugin.
	handle /video* {
		reverse_proxy 127.0.0.1:8096
	}
	# Music fetchers: Lidarr and slskd have no login of their own and trust this one.
	handle /lidarr* {
		import admin 127.0.0.1:8686
	}
	handle /slskd* {
		import admin 127.0.0.1:5030
	}
	# TV fetchers, the same way: no login of their own behind the admin check.
	handle /sonarr* {
		import admin 127.0.0.1:8989
	}
	handle /prowlarr* {
		import admin 127.0.0.1:9696
	}
	handle /radarr* {
		import admin 127.0.0.1:7878
	}
	handle /bazarr* {
		import admin 127.0.0.1:6767
	}
	# Graphs (Grafana with anonymous viewers on 127.0.0.1:3000). The home page's top bar
	# graphs read Prometheus through /grafana/api/datasources/proxy.
	handle /grafana* {
		import admin 127.0.0.1:3000
	}
	# An address to remember for Seerr, which has its own name or port.
	redir /requests* {$REQUESTS_URL} 302
	# qBittorrent has no URL base setting, so Caddy removes the /qbit prefix.
	redir /qbit /qbit/ 308
	handle_path /qbit/* {
		import admin 127.0.0.1:8081
	}
	# The home page shows data from the admin-only apps, so it is admin-only too.
	handle {
		import admin 127.0.0.2:3010
	}
}

# Seerr (show and movie requests) has no URL base setting, so it gets its own name or port. Users
# sign in twice: Authelia here, then Seerr with their Jellyfin account.
(seerr) {
	import site_headers
	# Admins only while Authelia has no other users; switch to login to let others request.
	import admin 127.0.0.1:5055
}

{$HOST}:443 {
	bind {$TS_IP}
	import tls_{$HOST_TLS:tailscale}
	import lab
}

{$HOST}:5055 {
	bind {$TS_IP}
	import tls_{$HOST_TLS:tailscale}
	import seerr
}

# The .invalid names never match a request. They stand in when a name is unset; compose.yml also
# sets them for empty names, which Caddy's defaults do not cover.
{$OLD_HOST:old.invalid}:443 {
	bind {$TS_IP}
	import tls_tailscale
	import lab
}

{$OLD_HOST:old.invalid}:5055 {
	bind {$TS_IP}
	import tls_tailscale
	import seerr
}

{$REQUESTS_HOST:requests.invalid}:443 {
	bind {$TS_IP}
	import tls_{$HOST_TLS:tailscale}
	import seerr
}
