# Copy to .env and fill in. HOST is this PC's full Tailscale name, without the last dot:
#   tailscale status --json | jq -r .Self.DNSName
# TS_IP is its Tailscale address: tailscale ip -4
# DATA holds app data and secrets; MEDIA holds music, video and downloads.
HOST=your-pc.your-tailnet.ts.net
# Optional, for a domain of your own (e.g. lab.example.com) whose DNS is at deSEC: set HOST to it,
# HOST_TLS=desec, and DESEC_TOKEN=<token> in DATA/secrets/desec.env. OLD_HOST keeps the ts.net name
# working; REQUESTS_HOST (a subdomain of HOST) serves Seerr without the :5055. With HOST_TLS=desec,
# set REQUESTS_HOST too, and give both names an A record with TS_IP at deSEC.
HOST_TLS=tailscale
OLD_HOST=
REQUESTS_HOST=
TS_IP=100.64.0.1
DATA=/home/you/homelab-data
MEDIA=/home/you/homelab-media
# The admin account's name in the lab login, Jellyfin and Navidrome.
LAB_USER=admin
# Optional: a GPU for faster video conversion in Jellyfin (ls /dev/dri, e.g. /dev/dri/renderD128)
# and the group id of render (getent group render). Empty means Jellyfin uses the CPU.
RENDER_DEVICE=
RENDER_GID=
# Optional: a command that gets one message argument when a long job ends, e.g. notify-send.
NOTIFY_CMD=
