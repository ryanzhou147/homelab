# Copy to .env and fill in. HOST is this PC's full Tailscale name, without the last dot:
#   tailscale status --json | jq -r .Self.DNSName
# TS_IP is its Tailscale address: tailscale ip -4
# DATA holds app data and secrets; MEDIA holds music, video and downloads.
HOST=your-pc.your-tailnet.ts.net
TS_IP=100.64.0.1
DATA=/home/you/homelab-data
MEDIA=/home/you/homelab-media
# The admin account's name in the lab login, Jellyfin and Navidrome.
LAB_USER=admin
# The GPU for video transcoding (ls /dev/dri), and the group id of render: getent group render
RENDER_DEVICE=/dev/dri/renderD128
RENDER_GID=992
# Optional: a command that gets one message argument when a long job ends, e.g. notify-send.
NOTIFY_CMD=
